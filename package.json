{
  "name": "kodrise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "sanity:seed-assets": "node scripts/seed-sanity-site-assets.mjs",
    "sanity:migrate-native-pages": "node --env-file=.env.local scripts/migrate-sanity-native-pages.mjs",
    "sanity:migrate-native-content": "node --env-file=.env.local scripts/migrate-native-page-content.mjs",
    "sanity:clean-unused-assets": "node --env-file=.env.local scripts/clean-unused-sanity-assets.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/home-content.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@sanity/image-url": "^2.1.1",
    "bootstrap": "^5.2.3",
    "jquery": "^3.6.3",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "^8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
